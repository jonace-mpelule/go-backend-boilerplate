APP_NAME=go-backend-boilerplate
APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/template?sslmode=disable
ATLAS_DIFF_DATABASE_URL=postgres://postgres:postgres@localhost:5432/template_diff?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=15m

JWT_SECRET=change-me-before-production-change-me-before-production
JWT_ISSUER=go-backend-boilerplate
JWT_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=168h
JWT_RESET_TOKEN_TTL=1h

MAILER_PROVIDER=resend
MAILER_FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
RESEND_URL=https://api.resend.com
MAILER_SMTP_HOST=localhost
MAILER_SMTP_PORT=1025
MAILER_SMTP_USERNAME=
MAILER_SMTP_PASSWORD=

REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=15m

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m

SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_BODY_LIMIT_BYTES=1048576

SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_NAMESPACE=go_backend
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_TENANT_ID=
LOKI_BASIC_AUTH_USERNAME=
LOKI_BASIC_AUTH_PASSWORD=
LOKI_BATCH_WAIT=5s
LOKI_LABELS=
